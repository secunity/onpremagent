[Unit]
Description=OnPremAgent SyncWorker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/work/onpremagent
ExecStart=/root/.local/bin/uv run python -m onpremagent sync
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
